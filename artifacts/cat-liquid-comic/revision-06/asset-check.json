        [
          370,
          141
        ],
        [
          2,
          129
        ]
      ],
      "caption": "“저쪽에 가면 소파도 있는 거야?”\n“그럼 우리도 가지.”",
      "fits": true
    },
    {
      "panel": 8,
      "sourceArt": "src/assets/story_cat_liquid_wide_panel_08.webp",
