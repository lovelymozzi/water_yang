        [
          358,
          141
        ],
        [
          12,
          141
        ]
      ],
      "caption": "차원문 너머로 연구실이 보였다.\n“인간 세계로 연결돼 있어!”",
      "fits": true
    },
    {
      "panel": 7,
      "sourceArt": "src/assets/story_cat_liquid_wide_panel_07.webp",
      "sourceSha256": "4e70beaa972af598bedf5024e75aaec3841e28cf02d980888c8d708784237253",
