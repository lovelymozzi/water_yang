        [
          370,
          15
        ],
        [
          370,
          141
        ],
        [
          2,
          141
        ]
      ],
      "caption": "“컵이든 상자든 몸을 맞춘다고?\n논문보다 더한데.”",
      "fits": true
    },
    {
      "panel": 5,
      "sourceArt": "src/assets/story_cat_liquid_wide_panel_05.webp",
      "sourceSha256": "55e7de59e2bd6da20945401ce9388cce421c43f7d167ec3a4807f9d281c3d0e3",
      "outline": [
