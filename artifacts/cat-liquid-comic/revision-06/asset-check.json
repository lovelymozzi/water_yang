        ],
        [
          2,
          129
        ]
      ],
      "caption": "도착한 곳엔 컵 고양이와 박스 고양이.\n“여긴 대체 어디지?”",
      "fits": true
    },
    {
      "panel": 4,
      "sourceArt": "src/assets/story_cat_liquid_wide_panel_04.webp",
      "sourceSha256": "866146c2eb5c908c8c93b5f8f5c4c3739cb0cef012d7af8c70d263816f66b214",
