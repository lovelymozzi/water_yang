        [
          370,
          4
        ],
        [
          370,
          130
        ],
        [
          2,
          141
        ]
      ],
      "caption": "“저 차원문, 너랑 같은 색이네.\n가까이 가 볼래?”",
      "fits": true
    },
    {
      "panel": 6,
      "sourceArt": "src/assets/story_cat_liquid_wide_panel_06.webp",
      "sourceSha256": "0d246b4b7a19941dafd404afc74e14da7661e1a2414b68a949c06b80dfc096fb",
