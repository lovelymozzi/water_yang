        [
          370,
          141
        ],
        [
          2,
          129
        ]
      ],
      "caption": "저 너머에 소파가 있네.\n저 인간 말은 반쯤 못 알아듣겠지만…\n일단 누울 자리는 합격.",
      "fits": true
    },
    {
      "panel": 8,
      "sourceArt": "src/assets/story_cat_liquid_misfit_panel_08.webp",
      "sourceCrop": [
        0,
        1161,
        1024,
        1536
      ],
