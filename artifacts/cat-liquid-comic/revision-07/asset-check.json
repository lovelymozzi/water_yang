      ],
      "caption": "고양이는 액체야… 틀림없어.\n내 이름 박힌 논문으로 증명해 주지.\n흐흐… 한 번만 더 측정하고.",
      "fits": true
    },
    {
      "panel": 2,
      "sourceArt": "src/assets/story_cat_liquid_misfit_panel_02.webp",
      "sourceCrop": [
        0,
        388,
        1024,
        730
      ],
      "sourceSha256": "81b52405759736e400432acba1d908388027ead66fc071ac5fd3e7823cccba7f",
      "outline": [
